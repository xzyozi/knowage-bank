# ============================================================
# Claude Code -> LiteLLM Proxy 連携設定
# ============================================================
# Claude Code CLI がリクエストを送信する先をローカルプロキシに設定
# 指定がない場合は Anthropic API (https://api.anthropic.com) に送信されます
ANTHROPIC_BASE_URL=http://localhost:4000/v1

# 認証キーは形式的に必要ですが、ローカル Ollama 運用の場合は任意の文字列で稼働します
ANTHROPIC_API_KEY=sk-locally-hosted-brain-key

# ============================================================
# Ollama / LiteLLM Proxy 設定
# ============================================================
# Ollama サーバーのアドレス
OLLAMA_BASE_URL=http://localhost:11434

# デフォルトで使用するモデル (LiteLLM 形式: ollama/モデル名)
# 推奨: ollama/qwen3-coder:30b, ollama/deepseek-r1:7b
KNOWAGE_BANK_MODEL=ollama/qwen3-coder:30b


# ============================================================
# システム設定
# ============================================================
LOG_LEVEL=INFO
MAX_RETRY=3

# ============================================================
# GitHub 連携設定 (Issueからの自動記事生成用)
# ============================================================
# 対象のGitHubリポジトリ (例: xzyozi/knowage-bank)
KNOWAGE_BANK_GITHUB_REPOSITORY=

# GitHub パーソナルアクセストークン (必須ではありませんが、レートリミット回避や自動プッシュに必要です)
# KNOWAGE_BANK_GITHUB_TOKEN=

# Deep Research MCP SSE の接続先。未接続時、記事同期はIssue本文へフォールバックします。
KNOWAGE_BANK_DEEPRESEARCH_SSE_URL=http://localhost:8000/sse

# ============================================================
# Google Gemini API 連携設定 (パーソナル・ナレッジ自動生成システム用)
# ============================================================
# --use-gemini フラグ使用時 (IntentFilter / SemanticClusterer) に必須
# GEMINI_API_KEY=
